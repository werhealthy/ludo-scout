rules_version = '2';

// Owner-only sync v1/v2/v3. All other collections remain inaccessible.
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid
        && uid == 'FxAKNm8aK6amBPoHZcXNOtSLv3t2';
    }
    function currentSnapshotId(uid, deviceId) {
      let p = /databases/$(database)/documents/sync_v2/$(uid)/devices/$(deviceId)/meta/current;
      return exists(p) ? get(p).data.snapshot_id : '';
    }
    function stagingSnapshot(uid, deviceId, snapshotId) {
      let p = /databases/$(database)/documents/sync_v2/$(uid)/devices/$(deviceId)/snapshots/$(snapshotId);
      return exists(p) && get(p).data.complete == false;
    }
    function validSnapshotListing(uid, deviceId, snapshotId) {
      let d=request.resource.data;
      return d.keys().hasAll(['schema_version','snapshot_id','source_id','item_id','title','brand','condition','price_cents','protected_price_cents','item_url','photo_urls','observed_text','category','category_source','lifecycle','enrichment_state','match_state','bgg_id','language','last_seen','manual_review','source_hash','synced_at'])
        && d.keys().hasOnly(['schema_version','snapshot_id','source_id','item_id','title','brand','condition','price_cents','protected_price_cents','item_url','photo_urls','observed_text','category','category_source','lifecycle','enrichment_state','match_state','bgg_id','language','last_seen','manual_review','source_hash','synced_at'])
        && stagingSnapshot(uid,deviceId,snapshotId) && d.schema_version==2 && d.snapshot_id==snapshotId
        && d.source_id is int && d.source_id>0 && d.source_hash is string && d.source_hash.matches('[0-9a-f]{64}') && d.synced_at==request.time;
    }
    match /sync_v1/{uid}/devices/{deviceId}/listings/{listingId} {
      allow read: if owner(uid);
      allow write: if false;
    }
    match /sync_v2/{uid}/devices/{deviceId}/meta/current {
      allow get: if owner(uid) && deviceId.matches('[a-z0-9-]{36}');
      allow list, write: if false;
    }
    match /sync_v2/{uid}/devices/{deviceId}/snapshots/{snapshotId} {
      allow get, list: if owner(uid) && deviceId.matches('[a-z0-9-]{36}');
      allow create, update, delete: if false;
      match /listings/{listingId} {
        allow get, list: if owner(uid) && deviceId.matches('[a-z0-9-]{36}');
        allow write: if false;
      }
    }
    function v3CurrentSnapshotId(uid, deviceId) {
      let p = /databases/$(database)/documents/sync_v3/$(uid)/devices/$(deviceId)/meta/current;
      return exists(p) ? get(p).data.snapshot_id : '';
    }
    function v3Staging(uid, deviceId, snapshotId) {
      let p = /databases/$(database)/documents/sync_v3/$(uid)/devices/$(deviceId)/snapshots/$(snapshotId);
      return exists(p) && get(p).data.complete == false;
    }
    function validV3Listing(uid, deviceId, snapshotId) {
      let d=request.resource.data;
      return v3Staging(uid,deviceId,snapshotId)
        && d.keys().hasAll(['schema_version','snapshot_id','source_id','language','has_title','has_category','has_bgg_id'])
        && d.keys().hasOnly(['schema_version','snapshot_id','source_id','language','has_title','has_category','has_bgg_id'])
        && d.schema_version is int && d.schema_version==3 && d.snapshot_id==snapshotId
        && d.source_id is int && d.source_id>0
        && d.language is string && d.language in ['IT','EN','DE','FR','ES','PT','NL','MULTI','OTHER','UNKNOWN']
        && d.has_title is bool && d.has_category is bool && d.has_bgg_id is bool;
    }
    match /sync_v3/{uid}/devices/{deviceId}/meta/current {
      allow get: if owner(uid) && deviceId.matches('[a-z0-9-]{36}');
      allow list: if false;
      allow create, update: if owner(uid) && deviceId.matches('[a-z0-9-]{36}')
        && request.resource.data.keys().hasOnly(['schema_version','snapshot_id','updated_at'])
        && request.resource.data.keys().hasAll(['schema_version','snapshot_id','updated_at'])
        && request.resource.data.schema_version==3 && request.resource.data.snapshot_id is string
        && request.resource.data.snapshot_id.matches('[a-z0-9-]{36}') && request.resource.data.updated_at==request.time
        && getAfter(/databases/$(database)/documents/sync_v3/$(uid)/devices/$(deviceId)/snapshots/$(request.resource.data.snapshot_id)).data.complete==true
        && getAfter(/databases/$(database)/documents/sync_v3/$(uid)/devices/$(deviceId)/snapshots/$(request.resource.data.snapshot_id)).data.content_hash is string;
      allow delete: if false;
    }
    match /sync_v3/{uid}/devices/{deviceId}/snapshots/{snapshotId} {
      function validManifest() {
        let d=request.resource.data;
        return d.keys().hasAll(['schema_version','snapshot_id','document_count','content_hash','complete','author_coverage_available','created_at'])
          && d.keys().hasOnly(['schema_version','snapshot_id','document_count','content_hash','complete','author_coverage_available','created_at'])
          && d.schema_version==3 && d.snapshot_id==snapshotId && d.document_count is int && d.document_count>=0
          && d.content_hash is string && d.content_hash.matches('[0-9a-f]{64}') && d.complete is bool
          && d.author_coverage_available is bool && d.author_coverage_available==false && d.created_at is timestamp;
      }
      allow get, list: if owner(uid) && deviceId.matches('[a-z0-9-]{36}') && snapshotId.matches('[a-z0-9-]{36}');
      allow create: if owner(uid) && deviceId.matches('[a-z0-9-]{36}') && snapshotId.matches('[a-z0-9-]{36}')
        && validManifest() && request.resource.data.complete==false && request.resource.data.created_at==request.time;
      allow update: if owner(uid) && deviceId.matches('[a-z0-9-]{36}') && snapshotId.matches('[a-z0-9-]{36}')
        && validManifest() && resource.data.complete==false && request.resource.data.complete==true
        && request.resource.data.schema_version==resource.data.schema_version && request.resource.data.snapshot_id==resource.data.snapshot_id
        && request.resource.data.document_count==resource.data.document_count && request.resource.data.content_hash==resource.data.content_hash
        && request.resource.data.author_coverage_available==resource.data.author_coverage_available && request.resource.data.created_at==resource.data.created_at;
      allow delete: if owner(uid) && deviceId.matches('[a-z0-9-]{36}') && snapshotId!=v3CurrentSnapshotId(uid,deviceId);
      match /listings/{listingId} {
        allow get, list: if owner(uid) && deviceId.matches('[a-z0-9-]{36}') && snapshotId.matches('[a-z0-9-]{36}') && listingId.matches('[0-9]{1,20}');
        allow create, update: if owner(uid) && deviceId.matches('[a-z0-9-]{36}') && snapshotId.matches('[a-z0-9-]{36}')
          && listingId.matches('[0-9]{1,20}') && request.resource.data.source_id==int(listingId) && validV3Listing(uid,deviceId,snapshotId);
        allow delete: if owner(uid) && deviceId.matches('[a-z0-9-]{36}') && snapshotId.matches('[a-z0-9-]{36}')
          && listingId.matches('[0-9]{1,20}') && snapshotId!=v3CurrentSnapshotId(uid,deviceId);
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
