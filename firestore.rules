rules_version = '2';

// Candidate only: preserve the existing v3 reader identity; no sync_v1/v2 access.
// Evidence fields expand the live write schema and require separate approval before publication.
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && uid == 'FxAKNm8aK6amBPoHZcXNOtSLv3t2';
    }

    function reader(uid) {
      return request.auth != null
        && request.auth.uid == '16LBChK0VrdfgyRuvDJ2myvHkY43'
        && request.auth.uid != 'FxAKNm8aK6amBPoHZcXNOtSLv3t2'
        && uid == 'FxAKNm8aK6amBPoHZcXNOtSLv3t2';
    }
    function currentSnapshotId(uid, deviceId) {
      let currentPath = /databases/$(database)/documents/sync_v3/$(uid)/devices/$(deviceId)/meta/current;
      return exists(currentPath) ? get(currentPath).data.snapshot_id : '';
    }

    function rollbackSnapshotId(uid, deviceId) {
      let currentPath = /databases/$(database)/documents/sync_v3/$(uid)/devices/$(deviceId)/meta/current;
      return exists(currentPath) && get(currentPath).data.keys().hasAny(['rollback_snapshot_id'])
        ? get(currentPath).data.rollback_snapshot_id : '';
    }

    function stagingSnapshot(uid, deviceId, snapshotId) {
      let manifestPath = /databases/$(database)/documents/sync_v3/$(uid)/devices/$(deviceId)/snapshots/$(snapshotId);
      return exists(manifestPath) && get(manifestPath).data.complete == false;
    }

    function validEvidenceUrl(value) {
      return value is string && value.size() <= 1200
        && value.matches('https://([A-Za-z0-9-]+[.])*vinted[.](net|com)/.*');
    }

    function validEvidencePhotos(values) {
      return values is list && values.size() <= 4
        && (values.size() < 1 || validEvidenceUrl(values[0]))
        && (values.size() < 2 || validEvidenceUrl(values[1]))
        && (values.size() < 3 || validEvidenceUrl(values[2]))
        && (values.size() < 4 || validEvidenceUrl(values[3]));
    }

    function validEvidenceFields(data) {
      let hasText = data.keys().hasAny(['observed_text']);
      let hasPhotos = data.keys().hasAny(['photo_urls']);
      return (hasText && hasPhotos
          && data.observed_text is string && data.observed_text.size() <= 2000
          && validEvidencePhotos(data.photo_urls))
        || (!hasText && !hasPhotos);
    }

    function completeSnapshot(uid, deviceId, snapshotId) {
      let manifestPath = /databases/$(database)/documents/sync_v3/$(uid)/devices/$(deviceId)/snapshots/$(snapshotId);
      return deviceId.matches('[a-z0-9-]{36}')
        && snapshotId.matches('[a-z0-9-]{36}')
        && currentSnapshotId(uid, deviceId) == snapshotId
        && exists(manifestPath)
        && get(manifestPath).data.schema_version is int
        && get(manifestPath).data.schema_version == 3
        && get(manifestPath).data.snapshot_id == snapshotId
        && get(manifestPath).data.complete is bool
        && get(manifestPath).data.complete == true
        && get(manifestPath).data.author_coverage_available is bool
        && get(manifestPath).data.author_coverage_available == false;
    }

    function validMinimalListing(snapshotId) {
      let data = request.resource.data;
      return data.keys().hasAll(['schema_version', 'snapshot_id', 'source_id', 'title', 'title_source', 'brand', 'brand_source', 'category', 'category_source', 'category_provenance_available', 'language', 'bgg_id', 'lifecycle', 'enrichment_state', 'match_state', 'source_hash'])
        && data.keys().hasOnly(['schema_version', 'snapshot_id', 'source_id', 'title', 'title_source', 'brand', 'brand_source', 'category', 'category_source', 'category_provenance_available', 'language', 'bgg_id', 'lifecycle', 'enrichment_state', 'match_state', 'observed_text', 'photo_urls', 'source_hash'])
        && data.schema_version is int && data.schema_version == 3 && data.snapshot_id == snapshotId
        && data.source_id is int && data.source_id > 0
        && data.title is string && data.title.size() <= 400 && data.title_source == 'VINTED_LISTING'
        && data.brand is string && data.brand.size() <= 120 && data.brand_source == 'VINTED_LISTING'
        && data.category is string && data.category.size() <= 80
        && data.category_source is string && data.category_source.size() <= 80
        && data.category_provenance_available is bool
        && data.category_provenance_available == (data.category_source != '')
        && data.language is string && data.language in ['IT', 'EN', 'DE', 'FR', 'ES', 'PT', 'NL', 'MULTI', 'OTHER', 'UNKNOWN']
        && data.bgg_id is string && data.bgg_id.size() <= 80
        && data.lifecycle is string && data.lifecycle.size() <= 40
        && data.enrichment_state is string && data.enrichment_state.size() <= 60
        && data.match_state is string && data.match_state.size() <= 60
        && data.source_hash is string && data.source_hash.matches('[0-9a-f]{64}')
        && validEvidenceFields(data);
    }

    function validStoredMinimalListing(snapshotId) {
      return resource.data.schema_version is int && resource.data.schema_version == 3
        && resource.data.snapshot_id == snapshotId
        && resource.data.source_id is int && resource.data.source_id > 0
        && resource.data.keys().hasAll(['schema_version', 'snapshot_id', 'source_id', 'title', 'title_source', 'brand', 'brand_source', 'category', 'category_source', 'category_provenance_available', 'language', 'bgg_id', 'lifecycle', 'enrichment_state', 'match_state', 'source_hash'])
        && resource.data.keys().hasOnly(['schema_version', 'snapshot_id', 'source_id', 'title', 'title_source', 'brand', 'brand_source', 'category', 'category_source', 'category_provenance_available', 'language', 'bgg_id', 'lifecycle', 'enrichment_state', 'match_state', 'observed_text', 'photo_urls', 'source_hash'])
        && resource.data.title is string && resource.data.title.size() <= 400 && resource.data.title_source == 'VINTED_LISTING'
        && resource.data.brand is string && resource.data.brand.size() <= 120 && resource.data.brand_source == 'VINTED_LISTING'
        && resource.data.category is string && resource.data.category.size() <= 80
        && resource.data.category_source is string && resource.data.category_source.size() <= 80
        && resource.data.category_provenance_available is bool
        && resource.data.category_provenance_available == (resource.data.category_source != '')
        && resource.data.language is string && resource.data.language in ['IT', 'EN', 'DE', 'FR', 'ES', 'PT', 'NL', 'MULTI', 'OTHER', 'UNKNOWN']
        && resource.data.bgg_id is string && resource.data.bgg_id.size() <= 80
        && resource.data.lifecycle is string && resource.data.lifecycle.size() <= 40
        && resource.data.enrichment_state is string && resource.data.enrichment_state.size() <= 60
        && resource.data.match_state is string && resource.data.match_state.size() <= 60
        && resource.data.source_hash is string && resource.data.source_hash.matches('[0-9a-f]{64}')
        && validEvidenceFields(resource.data);
    }
    function validPublishedManifest(snapshotId) {
      return resource.data.keys().hasAll(['schema_version', 'snapshot_id', 'document_count', 'content_hash', 'complete', 'author_coverage_available', 'created_at'])
        && resource.data.keys().hasOnly(['schema_version', 'snapshot_id', 'document_count', 'content_hash', 'complete', 'author_coverage_available', 'created_at'])
        && resource.data.schema_version is int && resource.data.schema_version == 3
        && resource.data.snapshot_id == snapshotId
        && resource.data.document_count is int && resource.data.document_count >= 0
        && resource.data.content_hash is string && resource.data.content_hash.matches('[0-9a-f]{64}')
        && resource.data.complete is bool && resource.data.complete == true
        && resource.data.author_coverage_available is bool && resource.data.author_coverage_available == false
        && resource.data.created_at is timestamp;
    }

    match /sync_v3/{uid}/devices/{deviceId}/meta/current {
      allow get: if (owner(uid) && deviceId.matches('[a-z0-9-]{36}'))
        || (deviceId.matches('[a-z0-9-]{36}')
        && resource.data.keys().hasAll(['schema_version', 'snapshot_id', 'updated_at'])
        && resource.data.keys().hasOnly(['schema_version', 'snapshot_id', 'rollback_snapshot_id', 'updated_at'])
        && resource.data.schema_version is int && resource.data.schema_version == 3
        && resource.data.snapshot_id is string && resource.data.snapshot_id.matches('[a-z0-9-]{36}')
        && resource.data.updated_at is timestamp
        && (!resource.data.keys().hasAny(['rollback_snapshot_id']) || resource.data.rollback_snapshot_id == '' || resource.data.rollback_snapshot_id.matches('[a-z0-9-]{36}'))
        && (owner(uid) || (reader(uid) && completeSnapshot(uid, deviceId, resource.data.snapshot_id))));
      allow list: if false;
      allow create, update: if owner(uid)
        && deviceId.matches('[a-z0-9-]{36}')
        && request.resource.data.keys().hasAll(['schema_version', 'snapshot_id', 'updated_at'])
        && request.resource.data.keys().hasOnly(['schema_version', 'snapshot_id', 'rollback_snapshot_id', 'updated_at'])
        && request.resource.data.schema_version is int && request.resource.data.schema_version == 3
        && request.resource.data.snapshot_id is string
        && request.resource.data.snapshot_id.matches('[a-z0-9-]{36}')
        && (!request.resource.data.keys().hasAny(['rollback_snapshot_id']) || (request.resource.data.rollback_snapshot_id is string && (request.resource.data.rollback_snapshot_id == '' || request.resource.data.rollback_snapshot_id.matches('[a-z0-9-]{36}'))))
        && request.resource.data.updated_at == request.time
        && getAfter(/databases/$(database)/documents/sync_v3/$(uid)/devices/$(deviceId)/snapshots/$(request.resource.data.snapshot_id)).data.complete == true
        && getAfter(/databases/$(database)/documents/sync_v3/$(uid)/devices/$(deviceId)/snapshots/$(request.resource.data.snapshot_id)).data.schema_version == 3
        && getAfter(/databases/$(database)/documents/sync_v3/$(uid)/devices/$(deviceId)/snapshots/$(request.resource.data.snapshot_id)).data.snapshot_id == request.resource.data.snapshot_id
        && getAfter(/databases/$(database)/documents/sync_v3/$(uid)/devices/$(deviceId)/snapshots/$(request.resource.data.snapshot_id)).data.content_hash is string
        && getAfter(/databases/$(database)/documents/sync_v3/$(uid)/devices/$(deviceId)/snapshots/$(request.resource.data.snapshot_id)).data.content_hash.matches('[0-9a-f]{64}')
        && getAfter(/databases/$(database)/documents/sync_v3/$(uid)/devices/$(deviceId)/snapshots/$(request.resource.data.snapshot_id)).data.document_count is int
        && getAfter(/databases/$(database)/documents/sync_v3/$(uid)/devices/$(deviceId)/snapshots/$(request.resource.data.snapshot_id)).data.document_count >= 0
        && getAfter(/databases/$(database)/documents/sync_v3/$(uid)/devices/$(deviceId)/snapshots/$(request.resource.data.snapshot_id)).data.author_coverage_available is bool
        && getAfter(/databases/$(database)/documents/sync_v3/$(uid)/devices/$(deviceId)/snapshots/$(request.resource.data.snapshot_id)).data.author_coverage_available == false
        && (!request.resource.data.keys().hasAny(['rollback_snapshot_id'])
          || request.resource.data.rollback_snapshot_id == ''
          || (exists(/databases/$(database)/documents/sync_v3/$(uid)/devices/$(deviceId)/snapshots/$(request.resource.data.rollback_snapshot_id))
            && get(/databases/$(database)/documents/sync_v3/$(uid)/devices/$(deviceId)/snapshots/$(request.resource.data.rollback_snapshot_id)).data.complete == true));
      allow delete: if false;
    }

    match /sync_v3/{uid}/devices/{deviceId}/snapshots/{snapshotId} {
      function validSnapshotManifest() {
        let data = request.resource.data;
        return data.keys().hasOnly(['schema_version', 'snapshot_id', 'document_count', 'content_hash', 'complete', 'author_coverage_available', 'created_at'])
          && data.keys().hasAll(['schema_version', 'snapshot_id', 'document_count', 'content_hash', 'complete', 'author_coverage_available', 'created_at'])
          && data.schema_version is int && data.schema_version == 3
          && data.snapshot_id == snapshotId
          && data.document_count is int && data.document_count >= 0
          && data.content_hash is string && data.content_hash.matches('[0-9a-f]{64}')
          && data.author_coverage_available is bool && data.author_coverage_available == false
          && data.created_at is timestamp;
      }
      allow get: if (owner(uid) && deviceId.matches('[a-z0-9-]{36}') && snapshotId.matches('[a-z0-9-]{36}'))
        || (reader(uid) && completeSnapshot(uid, deviceId, snapshotId)
          && validPublishedManifest(snapshotId));
      allow list: if false;
      allow create: if owner(uid) && deviceId.matches('[a-z0-9-]{36}')
        && snapshotId.matches('[a-z0-9-]{36}')
        && validSnapshotManifest()
        && request.resource.data.complete == false
        && request.resource.data.created_at is timestamp
        && request.resource.data.created_at == request.time;
      allow update: if owner(uid) && deviceId.matches('[a-z0-9-]{36}')
        && snapshotId.matches('[a-z0-9-]{36}')
        && validSnapshotManifest()
        && resource.data.keys().hasAll(['schema_version', 'snapshot_id', 'document_count', 'content_hash', 'complete', 'author_coverage_available', 'created_at'])
        && resource.data.keys().hasOnly(['schema_version', 'snapshot_id', 'document_count', 'content_hash', 'complete', 'author_coverage_available', 'created_at'])
        && resource.data.schema_version is int && resource.data.schema_version == 3
        && resource.data.snapshot_id == snapshotId
        && resource.data.document_count is int && resource.data.document_count >= 0
        && resource.data.content_hash is string && resource.data.content_hash.matches('[0-9a-f]{64}')
        && resource.data.complete is bool && resource.data.complete == false
        && resource.data.author_coverage_available is bool && resource.data.author_coverage_available == false
        && resource.data.created_at is timestamp
        && request.resource.data.complete == true
        && request.resource.data.schema_version == resource.data.schema_version
        && request.resource.data.snapshot_id == resource.data.snapshot_id
        && request.resource.data.document_count == resource.data.document_count
        && request.resource.data.content_hash == resource.data.content_hash
        && request.resource.data.author_coverage_available == resource.data.author_coverage_available
        && request.resource.data.created_at == resource.data.created_at;
      allow delete: if owner(uid) && deviceId.matches('[a-z0-9-]{36}')
        && snapshotId != currentSnapshotId(uid, deviceId)
        && snapshotId != rollbackSnapshotId(uid, deviceId);

      match /listings/{listingId} {
      allow get: if (owner(uid) && deviceId.matches('[a-z0-9-]{36}') && snapshotId.matches('[a-z0-9-]{36}') && listingId.matches('[0-9]{1,19}'))
        || (reader(uid) && completeSnapshot(uid, deviceId, snapshotId)
          && validStoredMinimalListing(snapshotId)
          && listingId.matches('[0-9]{1,19}') && resource.data.source_id == int(listingId));
        allow list: if (owner(uid) && deviceId.matches('[a-z0-9-]{36}') && snapshotId.matches('[a-z0-9-]{36}'))
          || (reader(uid) && completeSnapshot(uid, deviceId, snapshotId));
        allow create, update: if owner(uid) && deviceId.matches('[a-z0-9-]{36}')
          && snapshotId.matches('[a-z0-9-]{36}') && listingId.matches('[0-9]{1,19}')
          && request.resource.data.source_id == int(listingId)
          && validMinimalListing(snapshotId) && stagingSnapshot(uid, deviceId, snapshotId);
        allow delete: if owner(uid) && deviceId.matches('[a-z0-9-]{36}')
          && snapshotId.matches('[a-z0-9-]{36}') && snapshotId != currentSnapshotId(uid, deviceId)
          && snapshotId != rollbackSnapshotId(uid, deviceId);
      }
    }

    match /sync_v1/{document=**} { allow get, list: if false; allow create, update, delete: if false; }
    match /sync_v2/{document=**} { allow get, list: if false; allow create, update, delete: if false; }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
